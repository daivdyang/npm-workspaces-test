{
  "name": "npm_mono_test",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "npm_mono_test",
      "version": "1.0.0",
      "license": "ISC",
      "workspaces": [
        "apps/*",
        "packages/*"
      ]
    },
    "apps/app1": {
      "name": "@app/app1",
      "version": "1.0.0",
      "license": "ISC",
      "dependencies": {
        "@app/core": "*"
      }
    },
    "apps/app2": {
      "name": "@app/app2",
      "version": "1.0.0",
      "license": "ISC"
    },
    "node_modules/@app/app1": {
      "resolved": "apps/app1",
      "link": true
    },
    "node_modules/@app/app2": {
      "resolved": "apps/app2",
      "link": true
    },
    "node_modules/@app/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@app/ui": {
      "resolved": "packages/ui",
      "link": true
    },
    "packages/core": {
      "name": "@app/core",
      "version": "1.0.0",
      "license": "ISC"
    },
    "packages/ui": {
      "name": "@app/ui",
      "version": "1.0.0",
      "license": "ISC"
    }
  }
}
